# KHONG dien secret that vao file nay. Copy thanh .env.local khi chay local.
# Database (role app_user, KHONG phai owner, KHONG BYPASSRLS)
DATABASE_URL=postgresql://app_user:CHANGE_ME@localhost:5432/spa_saas
# Mat khau role app_user tren Neon (sinh boi packages/db/scripts/neon-roles-passwords.mjs,
# luu trong .env.local). Runtime API doi credential sang app_user nho bien nay.
APP_USER_PASSWORD=CHANGE_ME
# Role chay migration (chi dung tren may DB admin, khong dung trong app)
DATABASE_OWNER_URL=postgresql://app_owner:CHANGE_ME@localhost:5432/spa_saas
REDIS_URL=redis://localhost:6379
# JWT cho apps/api. Do dai >= 32 ky tu, sinh bang openssl rand -hex 32.
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=8h
# Subdomain goc, vd: spa.example.com -> store la <slug>.spa.example.com
PLATFORM_DOMAIN=example.com
# CORS cho API serverless: danh sach origin cua web, cach nhau bang dau phay.
# Mac dinh trong code la https://saas-spa-taupe.vercel.app.
CORS_ORIGINS=https://saas-spa-taupe.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:3001
API_PORT=3001
WEB_PORT=3000
NODE_ENV=development
