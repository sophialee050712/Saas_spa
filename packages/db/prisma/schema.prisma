// Prisma schema GĐ0: chi cac bang nen mong. Bang nghiep vu day du (booking,
// sales, package, ...) thuoc ve spec cua tung module sau, do Claude viet migration.
// Quy uoc: id uuid (UUIDv7 o app), tien bigint, thoi gian timestamptz UTC,
// bang danh muc xoa mem deleted_at, bang giao dich khong DELETE.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id           String   @id @db.Uuid
  slug         String   @unique
  name         String
  phone        String   @default("")
  timezone     String   @default("Asia/Ho_Chi_Minh")
  status       String   @default("trial")
  dbSecretRef  String?  @map("db_secret_ref")
  industryTemplateCode String? @map("industry_template_code")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  branches     Branch[]
  users        User[]
  settings     Setting[]
  @@map("tenants")
}

model Plan {
  id             String   @id @db.Uuid
  code           String   @unique
  name           String
  allowedModules Json     @map("allowed_modules")
  trialDays      Int      @default(14) @map("trial_days")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  @@map("plans")
}

model Branch {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  code      String   @default("main")
  name      String
  phone     String?
  isDefault Boolean  @default(false) @map("is_default")
  address   String?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([tenantId])
  @@map("branches")
}

model User {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  phone        String
  fullName     String   @default("") @map("full_name")
  passwordHash String   @map("password_hash")
  pinHash      String?  @map("pin_hash")
  pinFailedCount Int    @default(0) @map("pin_failed_count")
  pinLockedUntil DateTime? @map("pin_locked_until")
  loginFailedCount Int  @default(0) @map("login_failed_count")
  lockedUntil  DateTime? @map("locked_until")
  status       String   @default("active")
  inviteTokenHash String? @map("invite_token_hash")
  inviteExpiresAt DateTime? @map("invite_expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("users")
}

model Setting {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  key       String
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@unique([tenantId, key])
  @@map("settings")
}

model AuditLog {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id") @db.Uuid
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at")
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model IdempotencyKey {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  key        String
  requestHash String  @map("request_hash")
  response   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  @@unique([tenantId, key])
  @@map("idempotency_keys")
}

model OutboxEvent {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  eventType String   @map("event_type")
  payload   Json
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at")
  dispatchedAt DateTime? @map("dispatched_at")
  @@index([tenantId, status, createdAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  eventId  String @map("event_id") @db.Uuid
  consumer String
  tenantId String @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  @@id([eventId, consumer])
  @@map("processed_events")
}

// M01/M02 (Approved 2026-10-29). Bang platform khong co RLS (chi app_platform).
model Subscription {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  status    String   @default("trial")
  trialEndsAt DateTime? @map("trial_ends_at")
  currentPeriodEndsAt DateTime? @map("current_period_ends_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([tenantId, createdAt])
  @@map("subscriptions")
}

model SubscriptionInvoice {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  subscriptionId String @map("subscription_id") @db.Uuid
  periodStart DateTime @map("period_start")
  periodEnd DateTime @map("period_end")
  status    String   @default("draft")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([tenantId, createdAt])
  @@map("subscription_invoices")
}

model PlatformAdmin {
  id        String   @id @db.Uuid
  email     String   @unique
  passwordHash String @map("password_hash")
  totpSecretEncrypted String @map("two_factor_secret_encrypted")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("platform_admins")
}

model TenantModule {
  tenantId   String  @map("tenant_id") @db.Uuid
  moduleCode String  @map("module_code")
  entitled   Boolean @default(false)
  enabled    Boolean @default(false)
  @@id([tenantId, moduleCode])
  @@index([tenantId, moduleCode])
  @@map("tenant_modules")
}

model Role {
  id        String  @id @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  code      String
  name      String
  isSystem  Boolean @default(false) @map("is_system")
  @@unique([tenantId, code])
  @@index([tenantId, code])
  @@map("roles")
}

model Permission {
  code        String @id
  moduleCode  String @map("module_code")
  description String @default("")
  @@index([moduleCode])
  @@map("permissions")
}

model RolePermission {
  roleId         String @map("role_id") @db.Uuid
  permissionCode String @map("permission_code")
  conditions     Json   @default("{}")
  tenantId       String @map("tenant_id") @db.Uuid
  @@id([roleId, permissionCode])
  @@index([tenantId, roleId])
  @@map("role_permissions")
}

model UserBranchRole {
  userId   String @map("user_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  roleId   String @map("role_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  @@id([tenantId, userId, branchId, roleId])
  @@index([tenantId, userId])
  @@index([tenantId, branchId])
  @@map("user_branch_roles")
}

model RefreshToken {
  tokenHash String @id @map("token_hash")
  userId    String @map("user_id") @db.Uuid
  tenantId  String? @map("tenant_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([tenantId])
  @@map("refresh_tokens")
}
