{"devDependencies":{"@types/node":"^22.10.0","prettier":"^3.4.2","typescript":"^5.7.2"},"name":"spa-saas","packageManager":"pnpm@10.34.9","private":true,"scripts":{"build":"pnpm -r run build","db:check-rls":"pnpm --filter @spa-saas/db check-rls","db:migrate":"echo 'CHUA CHAY: can Postgres 16 that + pnpm --filter @spa-saas/db exec prisma migrate deploy (xem docs/GD0-README.md)'","dev":"pnpm --filter @spa-saas/web dev","dev:api":"pnpm --filter @spa-saas/api dev","dev:worker":"pnpm --filter @spa-saas/worker dev","format":"prettier --write \"**/*.{ts,tsx,json,md}\" --ignore-path .prettierignore","lint":"pnpm -r run lint","test":"pnpm --filter @spa-saas/shared test && pnpm --filter @spa-saas/api test","typecheck":"pnpm -r run typecheck"},"version":"0.0.0"}